# Existing application settings (replace placeholders locally; never commit .env).
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=
JWT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Exactly one email provider is supported. Blank keeps delivery unconfigured.
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM_NAME=R&J AC ACCESSARIES COM. LTD
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=
EMAIL_TIMEOUT_MS=15000
# Separate signing secret for POST /api/v1/webhooks/resend.
RESEND_WEBHOOK_SECRET=

# Live QA only: explicit developer/test inboxes, comma-separated. No customer mail.
EMAIL_QA_RECIPIENTS=
# Set only after the sender domain is actually verified in Resend.
EMAIL_QA_SENDER_VERIFIED=false

# Temporary Root Cloudinary credentials are LOCAL ONLY. Before deployment,
# replace them with a dedicated least-privilege R&J backend key. No auto-rotation.
